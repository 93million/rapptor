#! /usr/bin/env bash

set -e

DEPLOY_HOST="$1"
CERTCACHE_CERTBOT_EMAIL="$2"

E_MISSING_ARGS=1

usage ()
{
  SCRIPT_NAME=$(basename "$0")
  echo "$SCRIPT_NAME <host> <certbot-email>"
}

if [[ -z "$DEPLOY_HOST" || -z "$CERTCACHE_CERTBOT_EMAIL" ]]; then
  usage
  exit $E_MISSING_ARGS
fi

ansible-playbook \
  -e punk_base_domain="$DEPLOY_HOST" \
  -e certcache_certbot_email="$CERTCACHE_CERTBOT_EMAIL" \
  -i "$DEPLOY_HOST", ansible/playbook.yml
