#! /usr/bin/env bash

set -e

SCRIPT_DIR=$(dirname "$0")
E_MISSING_ARGS=1

error() {
  local parent_lineno="$1"
  local message="$2"
  local code="${3:-1}"
  if [[ -n "$message" ]] ; then
    echo "Error on or near line ${parent_lineno}: ${message}; exiting with status ${code}"
  else
    echo "Error on or near line ${parent_lineno}; exiting with status ${code}"
  fi
  exit "${code}"
}

exit_with_usage_msg()
{
  echo $1
  echo "$(basename $0) [-b git-branch] -c certbot-email -d <domain> -h <ssh-host> -n <instance-name> -p <account-password> [-P <ssh-pass>] -s <service-name> -u <account-user> -U <ssh-user>"
  exit $2
}

checkrequirements()
{
  if [ -z "$ACCOUNT_NAME" ]; then
    exit_with_usage_msg "Account name is missing" $E_MISSING_ARGS
  fi
  if [ -z "$ACCOUNT_PASS" ]; then
    exit_with_usage_msg "Account password is missing" $E_MISSING_ARGS
  fi
  if [ -z "$CERTCACHE_CERTBOT_EMAIL" ]; then
    exit_with_usage_msg "Certbot email is missing" $E_MISSING_ARGS
  fi
  if [ -z "$DOMAINS" ]; then
    exit_with_usage_msg "Domains are missing" $E_MISSING_ARGS
  fi
  if [ -z "$NAME" ]; then
    exit_with_usage_msg "Name is missing" $E_MISSING_ARGS
  fi
  if [ -z "$HOST" ]; then
    exit_with_usage_msg "Host is missing" $E_MISSING_ARGS
  fi
}

parse_args()
{
  local OPTIND OPTARG flag
  while getopts "b:c:d:h:n:p:P:u:U:" flag; do
    case "$flag" in
      b) GIT_BRANCH=$OPTARG;;
      c) CERTCACHE_CERTBOT_EMAIL=$OPTARG;;
      d) DOMAINS=$OPTARG;;
      h) HOST=$OPTARG;;
      n) NAME=$OPTARG;;
      p) ACCOUNT_PASS=$OPTARG;;
      P) SSH_PASS=$OPTARG;;
      u) ACCOUNT_NAME=$OPTARG;;
      U) SSH_USER=${OPTARG};;
    esac
  done

  if [ -z "SSH_USER" ]; then
    SSH_USER=root
  fi
}


main()
{
  parse_args "$@"
  checkrequirements
  cat "$SCRIPT_DIR/install-local" | \
    ssh \
      "$SSH_USER@$HOST" \
      /usr/bin/env bash /dev/stdin \
      -b \"$GIT_BRANCH\" \
      -c \"$CERTCACHE_CERTBOT_EMAIL\" \
      -d \"$DOMAINS\" \
      -n \"$NAME\" \
      -p \"$ACCOUNT_PASS\" \
      -u \"$ACCOUNT_NAME\"
}

trap 'error ${LINENO}' ERR
main "$@"
