#! /usr/bin/env bash

set -e

SCRIPT_DIR=$(dirname "$0")
E_MISSING_ARGS=1

error() {
  local parent_lineno="$1"
  local message="$2"
  local code="${3:-1}"
  if [[ -n "$message" ]] ; then
    echo "Error on or near line ${parent_lineno}: ${message}; exiting with status ${code}"
  else
    echo "Error on or near line ${parent_lineno}; exiting with status ${code}"
  fi
  exit "${code}"
}

exit_with_usage_msg()
{
  echo $1
  echo "$(basename $0) [-b branch] -h <ssh-host> -p <ssh-password> -u <ssh-user>"
  exit $2
}

checkrequirements()
{
  if [ -z "$HOST" ]; then
    exit_with_usage_msg "Host is missing" $E_MISSING_ARGS
  fi
}

parse_args()
{
  local OPTIND OPTARG flag
  while getopts "b:h:p:u:" flag; do
    case "$flag" in
      b) GIT_BRANCH=$OPTARG;;
      h) HOST=$OPTARG;;
      p) SSH_PASS=$OPTARG;;
      u) SSH_USER=${OPTARG};;
    esac
  done

  if [ -z "$SSH_USER" ]; then
    SSH_USER=root
  fi
}

main()
{
  parse_args "$@"
  checkrequirements
  cat "$SCRIPT_DIR/install" | \
    ssh \
      "$SSH_USER@$HOST" \
      /usr/bin/env bash /dev/stdin \
      -b \"$GIT_BRANCH\"
}

trap 'error ${LINENO}' ERR
main "$@"
