#! /usr/bin/env bash

set -e

SCRIPT=$(realpath "$0")
SCRIPT_DIR=$(dirname "$SCRIPT")
ROOT_DIR="$SCRIPT_DIR/../.."
DEV_CERT_DIR="$ROOT_DIR/dev/ssl"
CA_DIR="ca"
CONF_DIR="conf"

cd "$SCRIPT_DIR"
rm -rf "$DEV_CERT_DIR"
mkdir -p "$DEV_CERT_DIR" "$CA_DIR"

gen_ca()
{
  if [[ ! -f "$CA_DIR"/cert.pem ]]; then
    openssl \
      req \
      -x509 \
      -sha256 \
      -days 356 \
      -nodes \
      -newkey rsa:2048 \
      -subj "/CN=93 Million Root CA/C=UK/L=Newcastle upon Tyne" \
      -keyout "$CA_DIR"/privkey.pem \
      -out "$CA_DIR"/cert.pem
  fi
}

gen_cert()
{
  CERT_CONF_DIR="$1"
  CERT_OUT_DIR="$2"

  mkdir -p "$CERT_OUT_DIR"

  openssl genrsa -out "$CERT_OUT_DIR/privkey.pem" 2048
  openssl req -new -key "$CERT_OUT_DIR/privkey.pem" -out "$CERT_OUT_DIR/request.csr" -config "$CERT_CONF_DIR/csr.conf"
  openssl x509 -req \
      -in "$CERT_OUT_DIR/request.csr" \
      -CA "$CA_DIR"/cert.pem -CAkey "$CA_DIR"/privkey.pem \
      -CAcreateserial -out "$CERT_OUT_DIR/cert.pem" \
      -days 365 \
      -sha256 -extfile "$CERT_CONF_DIR/cert.conf"

  rm "$CERT_OUT_DIR/request.csr"
  cp "$CA_DIR"/cert.pem "$CERT_OUT_DIR/ca.pem"

  cat "$CERT_OUT_DIR/cert.pem" "$CERT_OUT_DIR/ca.pem" > "$CERT_OUT_DIR/fullchain.pem"
}

main()
{
  gen_ca
  gen_cert "$CONF_DIR/instance" "$DEV_CERT_DIR/instance"
}

main
