  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to control panel service",
      "port": 9229,
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node",
      "localRoot": "${workspaceFolder}/control-panel-service/",
      "remoteRoot": "/app/",
      "sourceMaps": true,
      "smartStep": true
    },
    {
      "name": "Attach to container proxy service",
      "port": 9230,
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node",
      "localRoot": "${workspaceFolder}/container-proxy-service/",
      "remoteRoot": "/app/",
      "sourceMaps": true,
      "smartStep": true
    }
  ]
}
